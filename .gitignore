# macOS
.DS_Store

# Ekstraksi teks dari PDF/HTML — turunan, bisa dibangkitkan ulang dari sumbernya.
# Dipakai sebagai bahan baca kerja, bukan sumber kebenaran.
.tmp_txt/

# Setelan lokal per-mesin
.claude/settings.local.json
.commandcode/

# ── Data anak: JANGAN PERNAH masuk repo ──────────────────────────────
# PRD §7.1 menetapkan privacy-by-default: tidak ada data anak yang keluar
# dari Mac+HP keluarga. Repo git bisa di-push/di-clone, jadi seluruh lapisan
# kejadian & turunan (PRD §8.4) diblokir di sini sejak sebelum ada datanya —
# supaya tidak ada momen di mana ia "kebetulan" ter-commit lalu permanen di
# riwayat git. Yang boleh masuk repo hanya lapisan konten/.
kejadian/
turunan/

# Lembar latihan yang SUDAH DIISI anak. Lembar kosong (SOAL/PENILAIAN) itu
# lapisan konten dan boleh masuk repo; begitu terisi jawaban, berkasnya jadi
# data anak dan tunduk aturan yang sama dengan turunan/. Konvensi nama:
# akhiri dengan -ISI.md atau taruh di latihan/hasil/.
latihan/hasil/
latihan/*-ISI.*

# Cache respons LLM: berisi diagnosis atas coretan anak (bukti, diagnosis,
# topik) — turunan langsung dari data anak, jadi diperlakukan sama dengan
# turunan/. Bisa dibangkitkan ulang dengan memanggil API lagi.
cache_llm/

# Artefak build/runtime app & skrip (belum ada, disiapkan lebih awal)
__pycache__/
*.pyc
.venv/
build/
*.apk
local.properties
.gradle/

# Artefak bundel (dibangkitkan ulang: python spike/bundel.py)
spike/latihan.html
spike/latihan-mudah.html

# Mesin latihan — lingkungan & artefak yang bisa dibangkitkan ulang
mesin/.venv/
mesin/**/__pycache__/
mesin/lembar/

# Basis data latihan: berisi jawaban & diagnosis anak. Sama statusnya dengan
# turunan/ — data anak, tidak pernah masuk repo. Cadangannya ke luar git.
mesin/*.db
mesin/*.db-journal
mesin/*.db-wal
mesin/*.db-shm
mesin/cadangan/

# Hash sandi guru. Bukan teks biasa, tapi tetap kredensial — dan berkas ini
# per-mesin (disetel ulang di tiap tempat aplikasi dipasang).
mesin/sandi.json

# Rencana kerja memuat detail internal (lihat AGENTS.md project polyflow untuk
# alasan yang sama): tetap lokal.
docs/plan/

# Knowledge graph graphify — artefak lokal, dibangkitkan ulang.
graphify-out/

# Dokumen turunan: PDF/HTML hasil ekspor dari .md sumber.
PRD.pdf
Rencana Produk - Peta Jalan.pdf
Rencana Produk - Peta Jalan.html
Rencana Spike - Coretan ke Diagnosis.html
